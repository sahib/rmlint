Import('env')
Import('programs')

import os
import shutil
import subprocess


def run_tests(target=None, source=None, env=None):
    pytest = shutil.which('pytest')
    if not pytest:
        print('Unable to find pytest in PATH')
        Exit(1)

    test_env = dict(os.environ, RM_TS_DIR='/tmp/rmlint-tests')
    Exit(subprocess.call(pytest, env=test_env))


if 'test' in COMMAND_LINE_TARGETS:
    env.Alias('test',
        env.Depends(
            env.Command('run_tests', None, Action(run_tests, "Running tests")),
            programs
        )
    )
