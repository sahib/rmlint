Import('env')
Import('create_uninstall_target')
Import('library')

PROGNAME = 'rmlint'

print('Building ' + PROGNAME)
program = env.Program(f'../{PROGNAME}', [f'{PROGNAME}.c', library])
env.Depends(program, [library])

if 'uninstall' in COMMAND_LINE_TARGETS:
    create_uninstall_target(env, '$PREFIX/bin/' + PROGNAME)

env.Alias(
    ['install', 'install-cli'],
    env.InstallPerm('$staged_prefix/bin', program, 0o755)
)

env.Default(program)
Return('program')
